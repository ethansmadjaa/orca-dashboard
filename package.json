{
  "name": "orca-dashboard",
  "version": "0.1.0",
  "description": "Live web dashboard for Orca coding agents: worktrees, branches, issues, PRs, agent and subagent states, and terminals.",
  "license": "MIT",
  "author": "Ethan Smadja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethansmadjaa/orca-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/ethansmadjaa/orca-dashboard/issues"
  },
  "homepage": "https://github.com/ethansmadjaa/orca-dashboard#readme",
  "keywords": [
    "orca",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "dashboard",
    "git-worktree",
    "bun",
    "react"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.3"
  },
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "demo": "ORCA_DASHBOARD_DEMO=1 bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
